<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Reminder_Email</name>
        <label>Send Reminder Email to Tenant</label>
        <locationX>176</locationX>
        <locationY>827</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Create_Reminder_Notice</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>varReminderContact.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>Reminder: Your Rent Payment Is Due Tomorrow</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>tmplReminderBody</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>sendRichBody</name>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Due_Date_Is_Tomorrow</name>
        <label>Due Date Is Tomorrow?</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Not Due Tomorrow</defaultConnectorLabel>
        <rules>
            <name>Is_Due_Tomorrow</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Due_Date__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>frmTomorrow</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Tenancy_For_Reminder</targetReference>
            </connector>
            <label>Due Tomorrow</label>
        </rules>
    </decisions>
    <decisions>
        <name>Tenant_Has_Email</name>
        <label>Tenant Has Email?</label>
        <locationX>176</locationX>
        <locationY>719</locationY>
        <defaultConnectorLabel>No Email</defaultConnectorLabel>
        <rules>
            <name>Has_Email_Reminder</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varReminderContact.Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Reminder_Email</targetReference>
            </connector>
            <label>Has Email</label>
        </rules>
    </decisions>
    <description>Runs daily at 8 AM. For each Scheduled or Unpaid rent payment due tomorrow, sends a reminder email to the tenant and creates a Rent Reminder Notice.</description>
    <environments>Default</environments>
    <formulas>
        <name>frmTomorrow</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 1</expression>
    </formulas>
    <interviewLabel>Rent Payment Due Tomorrow Reminder {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Rent Payment Due Tomorrow – Send Reminder</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
