<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Room_Exists</name>
        <label>Room Linked to Tenancy?</label>
        <locationX>182</locationX>
        <locationY>755</locationY>
        <defaultConnectorLabel>No Room</defaultConnectorLabel>
        <rules>
            <name>Room_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varTenancy.Room__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Room_Occupied</targetReference>
            </connector>
            <label>Room Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Status_Changed_To_Activated</name>
        <label>Status Changed to Activated?</label>
        <locationX>611</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>No Change</defaultConnectorLabel>
        <rules>
            <name>Status_Newly_Activated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Activated</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Related_Tenancy</targetReference>
            </connector>
            <label>Yes - Newly Activated</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Tenancy_Found</name>
        <label>Tenancy Found?</label>
        <locationX>380</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>No Tenancy</defaultConnectorLabel>
        <rules>
            <name>Tenancy_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varTenancy.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Tenancy_Active</targetReference>
            </connector>
            <label>Tenancy Found</label>
        </rules>
    </decisions>
    <description>When a Contract Status changes to Activated, sets the linked Tenancy to Active and the associated Room to Occupied.</description>
    <environments>Default</environments>
    <interviewLabel>Contract Activated - Activate Tenancy {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contract Activated - Activate Tenancy</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Related_Tenancy</name>
        <label>Get Related Tenancy</label>
        <locationX>380</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Tenancy_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Contract__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Tenancy__c</elementReference>
            </value>
        </filters>
        <object>Tenancy__c</object>
        <outputReference>varTenancy</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Room__c</queriedFields>
        <queriedFields>Status__c</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_Room_Occupied</name>
        <label>Set Room to Occupied</label>
        <locationX>50</locationX>
        <locationY>863</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varTenancy.Room__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Occupied</stringValue>
            </value>
        </inputAssignments>
        <object>Room__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Tenancy_Active</name>
        <label>Set Tenancy to Active</label>
        <locationX>182</locationX>
        <locationY>647</locationY>
        <connector>
            <targetReference>Check_Room_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varTenancy.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </inputAssignments>
        <object>Tenancy__c</object>
    </recordUpdates>
    <start>
        <locationX>485</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Status_Changed_To_Activated</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Activated</stringValue>
            </value>
        </filters>
        <object>Contract</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varTenancy</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Tenancy__c</objectType>
    </variables>
</Flow>
