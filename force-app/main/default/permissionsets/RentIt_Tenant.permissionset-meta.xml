<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Experience Cloud permission set for tenants. Grants read access to their own Tenancy, Room, Property, Notices, and Invoices. Allows creating Payment records for approval submission. Assign to Customer Community users.</description>

    <!-- ── Apex Class Access ───────────────────────────────────── -->
    <classAccesses>
        <apexClass>RentItPortalController</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <!-- ── Account fields ─────────────────────────────────────── -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Account.ABN__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Account.GST_Number__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Account.GST_Registered__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- ── Case fields ────────────────────────────────────────── -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Case.Property__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Case.Room__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Case.Tenancy__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- ── Invoice__c fields ──────────────────────────────────── -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Invoice__c.Balance_Due__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Invoice__c.GST_Amount__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Invoice__c.Period_End__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Invoice__c.Period_Start__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Invoice__c.Total_Amount__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Invoice__c.Total_Paid__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- ── Notice__c fields ───────────────────────────────────── -->
