    <!-- ── Payment__c fields ──────────────────────────────────── -->
    <!-- Excluded (required): Amount__c, Payment_Date__c, Payment_Method__c, Payment_Type__c, Status__c -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Payment__c.Comment__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Payment__c.Invoice__c</field>
