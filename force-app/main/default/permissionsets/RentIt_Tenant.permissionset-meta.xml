        <editable>false</editable>
        <field>Tenancy__c.Available_Credits__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Tenancy__c.Deposit_Amount__c</field>
