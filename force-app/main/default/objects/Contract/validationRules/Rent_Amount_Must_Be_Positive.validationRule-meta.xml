<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Rent_Amount_Must_Be_Positive</fullName>
    <active>true</active>
    <description>Rent amount must be a positive value.</description>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Rent_Amount__c)),
    Rent_Amount__c &lt;= 0
)</errorConditionFormula>
    <errorMessage>Rent Amount must be greater than zero.</errorMessage>
    <errorDisplayField>Rent_Amount__c</errorDisplayField>
</ValidationRule>
