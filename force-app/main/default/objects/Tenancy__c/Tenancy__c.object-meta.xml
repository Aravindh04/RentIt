<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>The central linking object that connects a Room to a Tenant (Contact). Stores all tenancy agreement details: rent amount, frequency, start/end dates, deposit, and contract reference. Also links to the tenant's Experience Cloud (Community) user account.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <label>Tenancy</label>
    <nameField>
        <displayFormat>TEN-{0000}</displayFormat>
        <label>Tenancy Number</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Tenancies</pluralLabel>
    <searchLayouts>
        <searchResultsAdditionalFields>Room__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Tenant__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Status__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Rent_Amount__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Next_Due_Date__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ControlledByParent</sharingModel>
</CustomObject>
