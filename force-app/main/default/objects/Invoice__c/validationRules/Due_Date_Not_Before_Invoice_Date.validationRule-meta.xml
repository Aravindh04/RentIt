<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Due_Date_Not_Before_Invoice_Date</fullName>
    <active>true</active>
    <description>Ensures the due date is on or after the invoice generation date.</description>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Invoice_Date__c)),
    NOT(ISBLANK(Due_Date__c)),
    Due_Date__c &lt; Invoice_Date__c
)</errorConditionFormula>
    <errorMessage>Due Date cannot be before the Invoice Date.</errorMessage>
    <errorDisplayField>Due_Date__c</errorDisplayField>
</ValidationRule>
