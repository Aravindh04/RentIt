<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <!--
        Grants all Customer Community Plus tenant users (in the RentIt_Community_Tenants group)
        read-only access to every Property__c record so they can view property details in the portal.

        The criteria cover all valid Property_Type__c picklist values (the field is required on every
        Property), so every Property record matches and is shared.

        Members are added to RentIt_Community_Tenants by the Network/Member management process
        when a community user registers.
    -->
    <sharingCriteriaRules>
        <fullName>All_Properties_Read_Only_To_Tenants</fullName>
        <accessLevel>Read</accessLevel>
        <label>All Properties Read-Only to Community Tenants</label>
        <criteriaItems>
            <field>Property_Type__c</field>
            <operation>equals</operation>
            <value>House</value>
        </criteriaItems>
        <criteriaItems>
            <field>Property_Type__c</field>
            <operation>equals</operation>
            <value>Apartment</value>
        </criteriaItems>
        <criteriaItems>
            <field>Property_Type__c</field>
            <operation>equals</operation>
            <value>Unit</value>
        </criteriaItems>
        <criteriaItems>
            <field>Property_Type__c</field>
            <operation>equals</operation>
            <value>Townhouse</value>
        </criteriaItems>
        <criteriaItems>
            <field>Property_Type__c</field>
            <operation>equals</operation>
            <value>Villa</value>
        </criteriaItems>
        <criteriaItems>
            <field>Property_Type__c</field>
            <operation>equals</operation>
            <value>Studio</value>
        </criteriaItems>
        <criteriaItems>
            <field>Property_Type__c</field>
            <operation>equals</operation>
            <value>Granny Flat</value>
        </criteriaItems>
        <booleanFilter>1 OR 2 OR 3 OR 4 OR 5 OR 6 OR 7</booleanFilter>
        <sharedTo>
            <group>RentIt_Community_Tenants</group>
        </sharedTo>
    </sharingCriteriaRules>
</SharingRules>
